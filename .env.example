# ClearSmile Reactivation — env vars
# Copy to .env.local for local dev. Set in Vercel for production.

# InsForge (Postgres + API)
INSFORGE_URL=
INSFORGE_API_KEY=

# SMTP (email delivery)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# Booking + admin base URLs
BOOKING_URL_BASE=

# Trigger configuration
OVERDUE_MONTHS=6
SUPPRESSION_DAYS=90

# Follow-up sequence (days after flag)
FOLLOWUP_DAYS="0,7,14"

# Clinic details
CLINIC_NAME="ClearSmile Dental"
CLINIC_ADDRESS="102 King St, Newtown"
CLINIC_CITY="Sydney, NSW 2042"
CLINIC_PHONE="(02) 9123 4567"

# Business hours for self-serve booking
BUSINESS_HOURS_START=8
BUSINESS_HOURS_END=18
SATURDAY_HOURS_START=9
SATURDAY_HOURS_END=16
BUSINESS_DAYS=mon,tue,wed,thu,fri,sat

# Demo seed (test runs only)
SEED_ENABLED=false